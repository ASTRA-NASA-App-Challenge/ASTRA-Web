@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@using Common.Identity
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isGroundControl = isAuthenticated && User.IsInRole(AppRoles.GroundControl);
    var isMedic = isAuthenticated && !isGroundControl && User.IsInRole(AppRoles.Medic);
    var overviewController = isGroundControl ? "Crew" : "Home";
    var overviewAction = isAuthenticated && !isGroundControl ? "Dashboard" : "Index";
    var overviewLabel = isGroundControl ? "Crew Overview" : isMedic ? "My Health" : isAuthenticated ? "Dashboard" : "Home";
    var overviewActive = ViewContext.RouteData.Values["controller"]?.ToString() == overviewController
        && (ViewContext.RouteData.Values["action"]?.ToString() == overviewAction
            || (isGroundControl && ViewContext.RouteData.Values["action"]?.ToString() is "Create" or "Edit" or "Delete" or "Health"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASTRA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["CoverPage"] is true ? "astra-cover-page" : "")">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark astra-navbar" aria-label="Main navigation">
            <div class="container-fluid astra-shell">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="astra-brand-mark" aria-hidden="true"></span><span>ASTRA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#astra-navigation" aria-controls="astra-navigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <svg class="astra-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
                        <path d="M4 8h16" /><path d="M4 16h16" />
                    </svg>
                </button>
                <div id="astra-navigation" class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-item">
                            <span class="astra-navbar__username">@User.Identity?.Name</span>
                        </div>
                    }
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link astra-navbar__home" asp-area="" asp-controller="@overviewController" asp-action="@overviewAction"
                               aria-current="@(overviewActive ? "page" : null)"><span class="astra-nav-label">@overviewLabel</span></a>
                        </li>
                        @if (isMedic) {
                            <li class="nav-item"><a class="nav-link astra-navbar__home" asp-area="" asp-controller="Medic" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Medic" ? "page" : null)"><span class="astra-nav-label">Crew Health</span></a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    @if (isGroundControl && HostEnvironment.EnvironmentName == "Development")
    {
        <link rel="stylesheet" href="~/css/demo-status.css" asp-append-version="true" />
        <partial name="_DemoSeedBanner" />
    }
    <div class="astra-page-content @(ViewData["FullWidth"] is true ? "container-fluid p-0" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="astra-footer">
        <div class="astra-shell astra-footer__content">
            <span class="astra-footer__brand">&copy; @DateTime.UtcNow.Year ASTRA</span>
            <span class="astra-footer__tagline">Human health, beyond Earth</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
