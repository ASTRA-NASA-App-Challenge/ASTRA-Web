@using Common.Identity
@using Entities.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn astra-button astra-button--primary astra-navbar__logout">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn astra-button astra-button--primary astra-navbar__login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
