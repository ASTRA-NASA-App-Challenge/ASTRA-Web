@model Common.Models.OnboardPersonnelCounts
@{
    ViewData["Title"] = "ASTRA | Astronaut Health";
    ViewData["FullWidth"] = true;
    ViewData["CoverPage"] = User.Identity?.IsAuthenticated != true;
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="astra-cover" data-space-cover>
        <div class="astra-cover__space" aria-hidden="true"></div>
        <div class="astra-cover__shade" aria-hidden="true"></div>

        <section class="astra-cover__content" aria-labelledby="cover-heading">
            <p class="astra-eyebrow">Human health, beyond Earth</p>
            <h1 id="cover-heading">ASTRA</h1>
            <p class="astra-cover__tagline">Stay mission-ready.<br /><span>Beyond Earth.</span></p>
            <p class="astra-cover__description">
                A simple health companion for astronauts. Track vital indicators,
                understand mission risks, and stay ready for the journey ahead.
            </p>
            <a class="btn astra-button astra-button--primary"
               asp-area="Identity"
               asp-page="/Account/Login">Login</a>
            <div class="astra-cover__status" aria-label="Current mission personnel">
                <span class="astra-cover__status-label">On-board</span>
                <div class="astra-cover__status-counters">
                    <div class="astra-cover__status-item">
                        <span class="astra-cover__status-dot" aria-hidden="true"></span>
                        <span>
                            <strong>@Model.Crew.ToString("D2")</strong>
                            Astronauts
                        </span>
                    </div>
                    <div class="astra-cover__status-item">
                        <span class="astra-cover__status-dot astra-cover__status-dot--medic" aria-hidden="true"></span>
                        <span>
                            <strong>@Model.Medics.ToString("D2")</strong>
                            Medics
                        </span>
                    </div>
                </div>
            </div>
        </section>
    </div>
}
