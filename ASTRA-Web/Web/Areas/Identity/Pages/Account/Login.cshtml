@page
@model Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p>Crew and medics: use your six-digit PIN as your password. Ground control: use your account password.</p>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Identifier">Username or email</label>
        <input asp-for="Input.Identifier" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Identifier" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password">Password / crew PIN</label>
        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
